{
  "version": "1.0",
  "description": "Supported agent configurations for cst2026-mcp. Add new agents here.",
  "default_agent": "codex",
  "agents": {
    "codex": {
      "name": "Codex",
      "config_format": "toml",
      "config_example": "codex.example.toml",
      "launch_command": "run-cst2026-mcp.cmd",
      "launch_command_unix": "run-cst2026-mcp.sh",
      "description": "OpenAI Codex CLI agent"
    },
    "claude": {
      "name": "Claude Desktop",
      "config_format": "json",
      "config_example": "claude.example.json",
      "launch_command": "node mcp/src/server.js",
      "description": "Anthropic Claude Desktop / Claude Code"
    },
    "cursor": {
      "name": "Cursor",
      "config_format": "json",
      "config_example": "cursor.example.json",
      "launch_command": "node mcp/src/server.js",
      "description": "Cursor IDE MCP integration"
    }
  },
  "shared_env_vars": [
    "CST_INSTALL_DIR",
    "CST_PYTHON_EXE",
    "CST_MACRO_ROOT",
    "CST_DESIGN_ENV_EXE"
  ]
}
